DB_PATH=artifacts/portal_automation.sqlite
ARTIFACTS_DIR=artifacts
BUSINESS_DATE=
HEADLESS=true
DEFAULT_TIMEOUT_SECONDS=30
# ORANGEHRM_TIMEOUT_SECONDS=45  # Optional override for slower OrangeHRM-style portals.
# SAUCEDEMO_TIMEOUT_SECONDS=15  # Optional override for faster SauceDemo-style portals.
MAX_RETRIES=2
STALE_ITEM_TIMEOUT_SECONDS=300
PLAYWRIGHT_TRACE_ON_FAILURE=true
PLAYWRIGHT_SCREENSHOT_ON_FAILURE=true

ORANGEHRM_BASE_URL=https://opensource-demo.orangehrmlive.com
ORANGEHRM_USERNAME=Admin
ORANGEHRM_PASSWORD=
ORANGEHRM_INPUT_PATH=data/orangehrm_employees.json

SAUCEDEMO_BASE_URL=https://www.saucedemo.com
SAUCEDEMO_PASSWORD=
SAUCEDEMO_INPUT_PATH=data/saucedemo_accounts.json

EMAIL_BACKEND=dry_run
REPORT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true
